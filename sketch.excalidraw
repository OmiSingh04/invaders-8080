      "updated": 1736485468349,
      "link": null,
      "locked": false,
      "text": "THE PENULTIMATE CHALLENGE - \n\nMAKE THIS PROCESSOR CYCLE ACCURATE.\n\nrun it at 2MHz, like they used to, back in 1970s.",
      "fontSize": 36,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE PENULTIMATE CHALLENGE - \n\nMAKE THIS PROCESSOR CYCLE ACCURATE.\n\nrun it at 2MHz, like they used to, back in 1970s.",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "oTJckTwPzjsT5P3T_VC6K",
      "type": "text",
      "x": 11196.082876953722,
      "y": 37041.029070729244,
      "width": 1139.0625,
      "height": 86.39999999999999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "M8OvoDPtowyOMCFYphJpq"
      ],
      "frameId": null,
      "index": "c4kJ",
      "roundness": null,
      "seed": 1660652046,
      "version": 211,
      "versionNonce": 1094200078,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1736485468349,
      "link": null,
      "locked": false,
      "text": "also take care that the interrupts occur in 120 Hertz.\nalternating half and full vblanks.(so 60 and 60)",
      "fontSize": 36,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "also take care that the interrupts occur in 120 Hertz.\nalternating half and full vblanks.(so 60 and 60)",
      "autoResize": true,
      "lineHeight": 1.2
    },
